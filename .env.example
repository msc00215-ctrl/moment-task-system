# ===== MOMENT 2026 LINE Bot — 環境変数サンプル =====
# このファイルをコピーして .env を作成してください (.env はコミット禁止)
# 本番環境（Render）では Dashboard の Environment Variables に直接設定します

# LINE Messaging API（LINE Developers Console から取得）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Google Apps Script Web App URL（GASエディタ → デプロイ → ウェブアプリ → URL）
GAS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxx/exec

# GAS との共有シークレット（GASの setupSecretToken() を実行して生成）
GAS_SECRET_TOKEN=moment2026_xxxxxxxx

# ログレベル（debug / info / warn / error）
LOG_LEVEL=info

# Node.js 実行環境
NODE_ENV=development
