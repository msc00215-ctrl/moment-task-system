# ===== ローカル開発専用 (.env はコミット禁止) =====
# 本番環境では Secret Manager を使うので、ここはあくまでローカルテスト用。
# Cloud Functions / App Engine では下記を Secret Manager に登録し、
# サービスアカウントに roles/secretmanager.secretAccessor を付与すること。

# GCP 設定
GCP_PROJECT_ID=moment-2026-prod
NODE_ENV=development

# Secret Manager に格納する Secret 名 (Resource ID ではなく Secret 名のみ)
SECRET_OPENAI_API_KEY=openai-api-key
SECRET_LINE_CHANNEL_ACCESS_TOKEN=line-channel-access-token
SECRET_LINE_CHANNEL_SECRET=line-channel-secret

# Spreadsheet / AppSheet
SPREADSHEET_ID=your-spreadsheet-id-here
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY_SECRET=appsheet-access-key

# ローカル開発時のみ使用 (本番では Secret Manager から取得するため空でOK)
LOCAL_OPENAI_API_KEY=
LOCAL_LINE_CHANNEL_ACCESS_TOKEN=
LOCAL_LINE_CHANNEL_SECRET=
LOCAL_APPSHEET_ACCESS_KEY=

# ログレベル
LOG_LEVEL=info
